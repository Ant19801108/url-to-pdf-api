# Guide:
#
# 1. Copy this file to .env
#
#    cp .env.sample .env
#
# 2. Fill the blanks / adjust values as needed.

# Development or production
NODE_ENV=development

# Port the HTTP server listens on
PORT=9000

# Allow requests over plain HTTP (needed for local testing without HTTPS).
# In production behind a reverse proxy (nginx/traefik) you can keep this true
# and terminate TLS at the proxy.
ALLOW_HTTP=true

# Run Chrome in headed mode (only for debugging; PDF rendering requires headless)
DEBUG_MODE=false

# Log level: error | warn | info | debug
LOG_LEVEL=info

# CORS origin (default "*" allows any origin)
# CORS_ORIGIN=*

# Optional: comma-separated list of accepted API keys.
# When set, clients must send one of them in the "x-api-key" header.
# API_TOKENS=secret123,anotherkey

# Optional: comma-separated list of allowed URL patterns (see README).
# Patterns: "host:example.com", "regex:...", or a plain URL (normalized match).
# ALLOW_URLS=host:example.com

# Disable HTML input (only allow url-based rendering)
# DISABLE_HTML_INPUT=false

# Optional: path to a Chrome/Chromium executable if you don't want to use
# the one bundled with Puppeteer.
# BROWSER_EXECUTABLE_PATH=/usr/bin/google-chrome

# Optional: connect to an already running browser instead of launching one.
# BROWSER_WS_ENDPOINT=ws://127.0.0.1:9222
